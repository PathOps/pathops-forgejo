diff --git a/tests/integration/pathops_login_test.go b/tests/integration/pathops_login_test.go
new file mode 100644
index 0000000..176f0ea
--- /dev/null
+++ b/tests/integration/pathops_login_test.go
@@ -0,0 +1,173 @@
+// Copyright 2026 The PathOps Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package integration
+
+import (
+	"net/http"
+	"net/url"
+	"testing"
+
+	auth_model "forgejo.org/models/auth"
+	"forgejo.org/models/unittest"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/setting"
+	"forgejo.org/modules/test"
+	"forgejo.org/tests"
+
+	"github.com/markbates/goth"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// PathOps Decision 0059: /user/login is the PathOps Dex source, local sign-in
+// only at /user/login/break-glass.
+
+const pathOpsBreakGlass = "/user/login/break-glass"
+
+// pathOpsDex adds the OpenID Connect source "dex" (a mock provider, closed by
+// the returned function to make it unavailable) and enables PATHOPS_LOGIN_SOURCE.
+func pathOpsDex(t *testing.T) (*auth_model.Source, func()) {
+	t.Helper()
+	provider := setupMockOIDCServer()
+	source := addAuthSource(t, authSourcePayloadOpenIDConnect("dex", provider.URL+"/"))
+	reset := test.MockVariableValue(&setting.Service.PathOpsLoginSource, "dex")
+	return source, func() {
+		reset()
+		provider.Close()
+	}
+}
+
+func TestPathOpsLoginRedirectsToDex(t *testing.T) {
+	defer tests.PrepareTestEnv(t)()
+	signedIn := loginUser(t, "user2")
+	_, done := pathOpsDex(t)
+	defer done()
+
+	session := emptyTestSession(t)
+	resp := session.MakeRequest(t, NewRequest(t, "GET", "/user/login?redirect_to=%2Fuser2%2Frepo1"), http.StatusSeeOther)
+	assert.Equal(t, "/user/oauth2/dex", test.RedirectURL(resp))
+	assert.NotContains(t, resp.Body.String(), `name="password"`)
+	// The Dex leg of the redirect: the provider's authorization endpoint.
+	resp = session.MakeRequest(t, NewRequest(t, "GET", "/user/oauth2/dex"), http.StatusTemporaryRedirect)
+	dest, err := url.Parse(resp.Header().Get("Location"))
+	require.NoError(t, err)
+	assert.Equal(t, "/authorize", dest.Path)
+	assert.Equal(t, "S256", dest.Query().Get("code_challenge_method"))
+
+	// A signed-in user still follows redirect_to, as upstream.
+	resp = signedIn.MakeRequest(t, NewRequest(t, "GET", "/user/login?redirect_to=%2Fuser2%2Frepo1"), http.StatusSeeOther)
+	assert.Equal(t, "/user2/repo1", test.RedirectURL(resp))
+}
+
+func TestPathOpsLoginOffersNoLocalForm(t *testing.T) {
+	defer tests.PrepareTestEnv(t)()
+	_, done := pathOpsDex(t)
+	defer done()
+
+	// Local credentials are refused at /user/login, even valid ones.
+	req := NewRequestWithValues(t, "POST", "/user/login", map[string]string{"user_name": "user2", "password": userPassword})
+	MakeRequest(t, req, http.StatusForbidden)
+
+	// A login source that is not an active OAuth2 source: no redirect and
+	// still no local form.
+	defer test.MockVariableValue(&setting.Service.PathOpsLoginSource, "no-such-source")()
+	resp := MakeRequest(t, NewRequest(t, "GET", "/user/login"), http.StatusServiceUnavailable)
+	assert.NotContains(t, resp.Body.String(), `name="password"`)
+	assert.NotContains(t, resp.Body.String(), pathOpsBreakGlass)
+}
+
+func TestPathOpsBreakGlass(t *testing.T) {
+	defer tests.PrepareTestEnv(t)()
+	_, done := pathOpsDex(t)
+	defer done()
+
+	resp := MakeRequest(t, NewRequest(t, "GET", pathOpsBreakGlass), http.StatusOK)
+	body := resp.Body.String()
+	assert.Contains(t, body, `action="`+pathOpsBreakGlass+`"`)
+	assert.Contains(t, body, `name="password"`)
+	assert.NotContains(t, body, "/user/oauth2/dex")
+
+	// Wrong password: the form again, at the same route.
+	req := NewRequestWithValues(t, "POST", pathOpsBreakGlass, map[string]string{"user_name": "user2", "password": "wrong"})
+	resp = MakeRequest(t, req, http.StatusOK)
+	assert.Contains(t, resp.Body.String(), `action="`+pathOpsBreakGlass+`"`)
+
+	pathOpsBreakGlassSignIn(t)
+}
+
+// The break-glass route needs nothing from the provider.
+func TestPathOpsBreakGlassWithoutDex(t *testing.T) {
+	defer tests.PrepareTestEnv(t)()
+	_, done := pathOpsDex(t)
+	done() // the provider is now unreachable
+	defer test.MockVariableValue(&setting.Service.PathOpsLoginSource, "dex")()
+	resp := MakeRequest(t, NewRequest(t, "GET", "/user/login"), http.StatusSeeOther)
+	assert.Equal(t, "/user/oauth2/dex", test.RedirectURL(resp))
+
+	resp = MakeRequest(t, NewRequest(t, "GET", pathOpsBreakGlass), http.StatusOK)
+	assert.Contains(t, resp.Body.String(), `name="password"`)
+	pathOpsBreakGlassSignIn(t)
+}
+
+// pathOpsBreakGlassSignIn signs user2 in at the break-glass route and uses
+// the session.
+func pathOpsBreakGlassSignIn(t *testing.T) {
+	t.Helper()
+	session := emptyTestSession(t)
+	req := NewRequestWithValues(t, "POST", pathOpsBreakGlass, map[string]string{"user_name": "user2", "password": userPassword})
+	resp := session.MakeRequest(t, req, http.StatusSeeOther)
+	assert.Equal(t, "/", test.RedirectURL(resp))
+	session.MakeRequest(t, NewRequest(t, "GET", "/user/settings"), http.StatusOK)
+}
+
+func TestPathOpsDexCallback(t *testing.T) {
+	defer tests.PrepareTestEnv(t)()
+	source, done := pathOpsDex(t)
+	defer done()
+
+	// An account of the Dex source signs in through the callback and lands
+	// on the redirect_to of /user/login.
+	user := &user_model.User{
+		Name: "dex.user", Email: "dex.user@example.com", Passwd: "dex.userpassword", Type: user_model.UserTypeIndividual,
+		LoginType: auth_model.OAuth2, LoginSource: source.ID, LoginName: "dex-subject-1", IsActive: true,
+	}
+	defer createUser(t.Context(), t, user)()
+	defer mockCompleteUserAuth(func(res http.ResponseWriter, req *http.Request) (goth.User, error) {
+		return goth.User{Provider: "dex", UserID: "dex-subject-1", Email: user.Email}, nil
+	})()
+	session := emptyTestSession(t)
+	session.MakeRequest(t, NewRequest(t, "GET", "/user/login?redirect_to=%2Fuser2%2Frepo1"), http.StatusSeeOther)
+	resp := session.MakeRequest(t, NewRequest(t, "GET", "/user/oauth2/dex/callback?code=XYZ&state=XYZ"), http.StatusSeeOther)
+	assert.Equal(t, "/user2/repo1", test.RedirectURL(resp))
+	session.MakeRequest(t, NewRequest(t, "GET", "/user/settings"), http.StatusOK)
+
+	// A new Dex user is registered automatically (the Cell's onboarding model).
+	defer test.MockVariableValue(&setting.OAuth2Client.EnableAutoRegistration, true)()
+	defer test.MockVariableValue(&setting.OAuth2Client.Username, setting.OAuth2UsernameEmail)()
+	defer mockCompleteUserAuth(func(res http.ResponseWriter, req *http.Request) (goth.User, error) {
+		return goth.User{Provider: "dex", UserID: "dex-subject-2", Email: "newdex@example.com"}, nil
+	})()
+	session = emptyTestSession(t)
+	session.MakeRequest(t, NewRequest(t, "GET", "/user/oauth2/dex/callback?code=XYZ&state=XYZ"), http.StatusSeeOther)
+	created := unittest.AssertExistsAndLoadBean(t, &user_model.User{Name: "newdex"})
+	assert.Equal(t, source.ID, created.LoginSource)
+	session.MakeRequest(t, NewRequest(t, "GET", "/user/settings"), http.StatusOK)
+}
+
+// Without PATHOPS_LOGIN_SOURCE: upstream behavior, no break-glass route.
+func TestPathOpsLoginUnset(t *testing.T) {
+	defer tests.PrepareTestEnv(t)()
+	provider := setupMockOIDCServer()
+	defer provider.Close()
+	addAuthSource(t, authSourcePayloadOpenIDConnect("dex", provider.URL+"/"))
+
+	resp := MakeRequest(t, NewRequest(t, "GET", "/user/login"), http.StatusOK)
+	assert.Contains(t, resp.Body.String(), `action="/user/login"`)
+	assert.Contains(t, resp.Body.String(), `name="password"`)
+	assert.Contains(t, resp.Body.String(), "/user/oauth2/dex")
+	MakeRequest(t, NewRequest(t, "GET", pathOpsBreakGlass), http.StatusNotFound)
+	req := NewRequestWithValues(t, "POST", pathOpsBreakGlass, map[string]string{"user_name": "user2", "password": userPassword})
+	MakeRequest(t, req, http.StatusNotFound)
+	loginUser(t, "user2").MakeRequest(t, NewRequest(t, "GET", "/user/settings"), http.StatusOK)
+}
