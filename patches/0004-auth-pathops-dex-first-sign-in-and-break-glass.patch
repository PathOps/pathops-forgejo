diff --git a/routers/web/auth/pathops_login.go b/routers/web/auth/pathops_login.go
new file mode 100644
index 0000000..86d02c6
--- /dev/null
+++ b/routers/web/auth/pathops_login.go
@@ -0,0 +1,96 @@
+// Copyright 2026 The PathOps Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package auth
+
+import (
+	"net/http"
+	"net/url"
+
+	auth_model "forgejo.org/models/auth"
+	"forgejo.org/modules/log"
+	"forgejo.org/modules/optional"
+	"forgejo.org/modules/setting"
+	"forgejo.org/services/auth/source/oauth2"
+	"forgejo.org/services/context"
+)
+
+// PathOps Dex-first sign-in (PathOps Decision 0059). With [service]
+// PATHOPS_LOGIN_SOURCE naming an OAuth2 authentication source, the normal
+// sign-in page is that source: /user/login redirects to /user/oauth2/<name>
+// and offers no local form. Local username/password sign-in is served only at
+// /user/login/break-glass, a recovery route that is not linked and does not
+// depend on the OAuth2 provider. Without the setting, upstream behavior.
+
+const breakGlassPath = "/user/login/break-glass"
+
+// pathOpsSignIn answers GET /user/login when a PathOps login source is set:
+// a redirect to the source, or, when the source is not an active OAuth2
+// source, the sign-in page without the local form. False: upstream behavior.
+func pathOpsSignIn(ctx *context.Context) bool {
+	name := setting.Service.PathOpsLoginSource
+	if name == "" {
+		return false
+	}
+	source, err := auth_model.GetActiveOAuth2SourceByName(ctx, name)
+	if err == nil {
+		// redirect_to was kept in its cookie by CheckAutoLogin.
+		ctx.Redirect(setting.AppSubURL + "/user/oauth2/" + url.PathEscape(source.Name))
+		return true
+	}
+	log.Error("PATHOPS_LOGIN_SOURCE %q is not an active OAuth2 authentication source: %v", name, err)
+	providers, err := oauth2.GetOAuth2Providers(ctx, optional.Some(true))
+	if err != nil {
+		ctx.ServerError("UserSignIn", err)
+		return true
+	}
+	ctx.Data["OAuth2Providers"] = providers
+	ctx.Data["Title"] = ctx.Tr("sign_in")
+	ctx.Data["SignInLink"] = setting.AppSubURL + "/user/login"
+	ctx.Data["PageIsSignIn"] = true
+	ctx.Data["PageIsLogin"] = true
+	ctx.Data["EnableInternalSignIn"] = false
+	ctx.Data["DisablePassword"] = true
+	ctx.HTML(http.StatusServiceUnavailable, tplSignIn)
+	return true
+}
+
+// breakGlassEnabled: the route exists only with a PathOps login source, and
+// only while local sign-in is enabled at all.
+func breakGlassEnabled() bool {
+	return setting.Service.PathOpsLoginSource != "" && setting.Service.EnableInternalSignIn
+}
+
+// SignInBreakGlass renders the local sign-in form, without OAuth2 sources.
+func SignInBreakGlass(ctx *context.Context) {
+	if !breakGlassEnabled() {
+		ctx.NotFound("SignInBreakGlass", nil)
+		return
+	}
+	if CheckAutoLogin(ctx) {
+		return
+	}
+	if ctx.IsSigned {
+		RedirectAfterLogin(ctx)
+		return
+	}
+	ctx.Data["Title"] = ctx.Tr("sign_in")
+	ctx.Data["SignInLink"] = setting.AppSubURL + breakGlassPath
+	ctx.Data["PageIsSignIn"] = true
+	ctx.Data["PageIsLogin"] = true
+	ctx.Data["EnableInternalSignIn"] = true
+	ctx.Data["DisablePassword"] = false
+	if setting.Service.EnableCaptcha && setting.Service.RequireCaptchaForLogin {
+		context.SetCaptchaData(ctx)
+	}
+	ctx.HTML(http.StatusOK, tplSignIn)
+}
+
+// SignInBreakGlassPost signs in with a local username and password.
+func SignInBreakGlassPost(ctx *context.Context) {
+	if !breakGlassEnabled() {
+		ctx.NotFound("SignInBreakGlassPost", nil)
+		return
+	}
+	signInPost(ctx, setting.AppSubURL+breakGlassPath, false)
+}
