+// Copyright 2026 The PathOps Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package permissions
+
+import (
+	"testing"
+
+	"forgejo.org/services/auth"
+	"forgejo.org/services/auth/pathops"
+
+	"github.com/stretchr/testify/assert"
+)
+
+type tokenResult struct {
+	auth.AuthenticationResult // only the methods below are called
+}
+
+func (*tokenResult) IsPasswordAuthentication() bool     { return false }
+func (*tokenResult) IsReverseProxyAuthentication() bool { return false }
+
+type pathopsResult struct {
+	tokenResult
+	d *pathops.Delegation
+}
+
+func (r *pathopsResult) PathOpsDelegation() *pathops.Delegation { return r.d }
+
+// permissionContext: embedded as Context, its field would hide the method.
+type permissionContext = Context
+
+type basicAuthContext struct {
+	permissionContext // only the methods below are called
+	signed            bool
+	result            auth.AuthenticationResult
+	status            int
+}
+
+func (c *basicAuthContext) IsSigned() bool                            { return c.signed }
+func (c *basicAuthContext) Authentication() auth.AuthenticationResult { return c.result }
+func (c *basicAuthContext) Error(status int, _ string, _ any)         { c.status = status }
+
+// A PathOps delegated token passes the basic-auth-only routes (its details
+// were checked against the exact request before routing); any other token
+// still does not.
+func TestReqBasicOrRevProxyAuthPathOps(t *testing.T) {
+	delegated := &basicAuthContext{signed: true, result: &pathopsResult{d: &pathops.Delegation{}}}
+	ReqBasicOrRevProxyAuth(delegated)
+	assert.Zero(t, delegated.status)
+
+	for name, c := range map[string]*basicAuthContext{
+		"not a delegated token":        {signed: true, result: &tokenResult{}},
+		"authorized integration token": {signed: true, result: &pathopsResult{}},
+		"not signed":                   {signed: false, result: &pathopsResult{d: &pathops.Delegation{}}},
+	} {
+		ReqBasicOrRevProxyAuth(c)
+		assert.Equal(t, 401, c.status, name)
+	}
+}
