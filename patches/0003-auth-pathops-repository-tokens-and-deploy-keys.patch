+// tokens decides on the token user's access tokens: list them, create exactly
+// a detail's repository token, or delete one by a detail's exact name.
+func (d *Delegation) tokens(r *http.Request, login string, sub []string) error {
+	m := r.Method
+	switch {
+	case m == http.MethodGet && len(sub) == 0:
+		for _, dt := range d.Details {
+			if dt.Type == TypeRepositoryToken {
+				return nil
+			}
+		}
+	case m == http.MethodPost && len(sub) == 0:
+		var body struct {
+			Name         string   `json:"name"`
+			Scopes       []string `json:"scopes"`
+			Repositories []struct {
+				Owner string `json:"owner"`
+				Name  string `json:"name"`
+			} `json:"repositories"`
+		}
+		if err := readJSON(r, &body); err != nil {
+			return err
+		}
+		if len(body.Repositories) == 1 {
+			dt := d.find(TypeRepositoryToken, body.Repositories[0].Owner, body.Repositories[0].Name, "create")
+			if dt != nil && strings.EqualFold(dt.Owner, login) && body.Name == dt.Name && slices.Equal(body.Scopes, dt.Scopes) {
+				return nil
+			}
+		}
+		return fmt.Errorf("%w: create access token %q", ErrDenied, body.Name)
+	case m == http.MethodDelete && len(sub) == 1:
+		for _, dt := range d.Details {
+			if dt.Type == TypeRepositoryToken && dt.Name == sub[0] && slices.Contains(dt.Actions, "revoke") {
+				return nil
+			}
+		}
 	}
 	return fmt.Errorf("%w: %s %s", ErrDenied, m, r.URL.Path)
