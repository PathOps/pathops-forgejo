+func TestParseRepositoryTokenAndDeployKey(t *testing.T) {
+	with := func(base map[string]any, k string, v any) map[string]any {
+		m := map[string]any{}
+		for key, val := range base {
+			m[key] = val
+		}
+		if v == nil {
+			delete(m, k)
+		} else {
+			m[k] = v
+		}
+		return m
+	}
+	tok, key := repositoryToken("app-a", "create"), deployKey("app-a")
+	for name, detail := range map[string]map[string]any{
+		"token without name":          with(tok, "name", nil),
+		"token name parses as an id":  with(tok, "name", "0x1f"),
+		"token wider scopes":          with(tok, "scopes", []string{"read:repository", "write:repository"}),
+		"token other scope":           with(tok, "scopes", []string{"write:repository"}),
+		"token without scopes":        with(tok, "scopes", nil),
+		"token unknown action":        with(tok, "actions", []string{"delete"}),
+		"token with deploy key title": with(tok, "title", "x"),
