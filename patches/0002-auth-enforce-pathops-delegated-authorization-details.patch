+
+func repo(name string, actions ...string) map[string]any {
+	return map[string]any{"type": TypeRepository, "version": 1, "tool": "forgejo", "owner": "gaston", "repository": name, "actions": actions}
+}
+
+func webhook(name string) map[string]any {
+	return map[string]any{"type": TypeWebhook, "version": 1, "tool": "forgejo", "owner": "gaston", "repository": name,
+		"url": hook, "events": []string{"push"}, "actions": []string{"configure"}}
