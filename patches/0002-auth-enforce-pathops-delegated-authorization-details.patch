+
+func delegation(t *testing.T, details ...map[string]any) *Delegation {
+	t.Helper()
+	var claims map[string]any
+	raw, _ := json.Marshal(map[string]any{"azp": "pathops-tenant-control-plane", "pathops_grant": "plan-1", "authorization_details": details})
+	require.NoError(t, json.Unmarshal(raw, &claims))
+	d, err := Parse(claims)
+	require.NoError(t, err)
+	return d
+}
+
+func call(d *Delegation, method, path, body string) error {
+	var r *http.Request
+	if body != "" {
+		r = httptest.NewRequest(method, path, strings.NewReader(body))
+	} else {
+		r = httptest.NewRequest(method, path, nil)
+	}
+	err := d.Authorize(r, "gaston", "/api/v1")
+	if err == nil && body != "" {
+		// The handler still gets the body.
+		got, _ := io.ReadAll(r.Body)
+		if string(got) != body {
+			return errors.New("body not restored")
+		}
+	}
+	return err
+}
+
+func TestSourceRepositoryToken(t *testing.T) {
+	d := delegation(t, repo("app-a", "create", "seed"))
+	for _, c := range []struct{ method, path, body string }{
+		{"GET", "/api/v1/user", ""},
+		{"POST", "/api/v1/user/repos", `{"name":"app-a","private":true}`},
+		{"POST", "/api/v1/user/repos", `{"name":"APP-A"}`}, // Forgejo names are case-insensitive
+		{"GET", "/api/v1/repos/gaston/app-a", ""},
+		{"GET", "/api/v1/repos/Gaston/app-a", ""},
+		{"GET", "/api/v1/repos/gaston/app%2Da", ""}, // an escaped ordinary character is the same name
+		{"GET", "/api/v1/repos/gaston/app-a/branches/main", ""},
+		{"GET", "/api/v1/repos/gaston/app-a/git/trees/0123abcd?recursive=true", ""},
+		{"POST", "/api/v1/repos/gaston/app-a/contents", `{"files":[]}`},
+	} {
+		assert.NoError(t, call(d, c.method, c.path, c.body), "%s %s", c.method, c.path)
+	}
+	for _, c := range []struct{ method, path, body string }{
+		// another Application
+		{"POST", "/api/v1/user/repos", `{"name":"app-b"}`},
+		{"GET", "/api/v1/repos/gaston/app-b", ""},
+		{"POST", "/api/v1/repos/gaston/app-b/contents", `{"files":[]}`},
+		{"POST", "/api/v1/repos/gaston/app-b/hooks", `{"config":{"url":"` + hook + `"}}`},
+		// this Application's other repositories
+		{"POST", "/api/v1/user/repos", `{"name":"app-a-gitops-preflight"}`},
+		{"POST", "/api/v1/repos/gaston/app-a-gitops-production/contents", `{}`},
+		// actions the detail does not have
+		{"DELETE", "/api/v1/repos/gaston/app-a", ""},
+		{"PATCH", "/api/v1/repos/gaston/app-a", `{"private":false}`},
+		{"POST", "/api/v1/repos/gaston/app-a/hooks", `{"config":{"url":"` + hook + `"}}`},
+		{"GET", "/api/v1/repos/gaston/app-a/hooks", ""},
+		{"POST", "/api/v1/repos/gaston/app-a/keys", `{"key":"ssh-ed25519 AAAA"}`},
+		{"POST", "/api/v1/user/keys", `{"key":"ssh-ed25519 AAAA"}`},
+		{"GET", "/api/v1/admin/users", ""},
+		{"POST", "/api/v1/orgs/acme/repos", `{"name":"app-a"}`},
+		// another user's repository of the same name
+		{"GET", "/api/v1/repos/alice/app-a", ""},
+		// path tricks and ambiguous bodies
+		{"GET", "/api/v1/repos/gaston/app-a/../app-b", ""},
+		{"GET", "/api/v1/repos/gaston//app-a", ""},
+		{"GET", "/api/v1/repos/gaston/app-b%2F..%2Fapp-a", ""},
+		{"GET", "/api/v1/repos/gaston/app-a%2Fhooks", ""},
+		{"POST", "/api/v1/user/repos", `{"name":"app-a","Name":"app-b"}`},
+		{"POST", "/api/v1/user/repos", `{"name":"app-a","name":"app-b"}`},
+		{"POST", "/api/v1/user/repos", `not json`},
+		{"GET", "/api/forgejo/v1/version", ""},
+		{"GET", "/gaston/app-a.git/info/refs", ""},
+	} {
+		err := call(d, c.method, c.path, c.body)
+		assert.ErrorIs(t, err, ErrDenied, "%s %s %s", c.method, c.path, c.body)
+	}
+}
