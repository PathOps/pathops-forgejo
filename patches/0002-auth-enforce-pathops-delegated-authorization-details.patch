+
+// pathopsDelegation refuses every request a PathOps delegated token's
+// authorization_details do not authorize, before any handler runs.
+func pathopsDelegation(ctx *context.APIContext) {
+	ar, ok := ctx.Authentication().(interface{ PathOpsDelegation() *pathops.Delegation })
+	if !ok || ar.PathOpsDelegation() == nil || ctx.Doer() == nil {
+		return
+	}
+	if err := ar.PathOpsDelegation().Authorize(ctx.Req, ctx.Doer().LowerName, setting.AppSubURL+"/api/v1"); err != nil {
+		log.Info("PathOps delegation refused %s %s for %s: %v", ctx.Req.Method, ctx.Req.URL.Path, ctx.Doer().Name, err)
+		ctx.Error(http.StatusForbidden, "PathOpsDelegation", err)
+	}
+}
