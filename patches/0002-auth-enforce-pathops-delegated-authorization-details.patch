index 0000000..9fa42c1
--- /dev/null
+++ b/services/auth/method/authorized_integration_pathops_test.go
@@ -0,0 +1,87 @@
+// Copyright 2026 The PathOps Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package method
+
+import (
+	"fmt"
+	"net/http/httptest"
+	"testing"
+
+	auth_model "forgejo.org/models/auth"
+	"forgejo.org/models/unittest"
+	"forgejo.org/modules/setting"
+	"forgejo.org/modules/test"
+	"forgejo.org/services/auth"
+	"forgejo.org/services/auth/pathops"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func pathopsDetails() []any {
+	return []any{map[string]any{"type": "pathops_repository", "version": 1, "tool": "forgejo", "owner": "user2",
+		"repository": "app-a", "actions": []any{"create", "seed"}}}
+}
+
+// A token of the PathOps delegation issuer is accepted only through an
+// integration that pins sub and azp, only with the configured azp, only on the
+// API, and carries its parsed authorization_details.
+func TestAuthorizedIntegrationPathOps(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	pinTo := func(azp string) aiDBTweak {
+		return func(ai *auth_model.AuthorizedIntegration) {
+			ai.ClaimRules.Rules = append(ai.ClaimRules.Rules,
+				auth_model.ClaimRule{Claim: "sub", Comparison: auth_model.ClaimEqual, Value: "user-sub"},
+				auth_model.ClaimRule{Claim: "azp", Comparison: auth_model.ClaimEqual, Value: azp})
+		}
+	}
+	pinned := pinTo("pathops-tenant-control-plane")
+	claims := func(azp string, details any) claimTweak {
+		return func(c *flexibleClaims) {
+			c.Subject = "user-sub"
+			c.other["azp"] = azp
+			if details != nil {
+				c.other["authorization_details"] = details
+			}
+		}
+	}
+	verify := func(t *testing.T, path string, tweaks ...tweak) auth.MethodOutput {
+		ait := newAITester(t, tweaks...)
+		t.Cleanup(ait.close)
+		t.Cleanup(test.MockVariableValue(&setting.AuthorizedIntegration.PathOpsDelegationIssuer, ait.dbAI.Issuer))
+		t.Cleanup(test.MockVariableValue(&setting.AuthorizedIntegration.PathOpsDelegationAuthorizedParty, "pathops-tenant-control-plane"))
+		req := httptest.NewRequest("GET", "https://forgejo.example.org"+path, nil)
+		req.Header.Set("Authorization", fmt.Sprintf("Bearer %s", ait.signedJWT()))
+		return ait.ai.Verify(req, nil, nil)
+	}
+
+	t.Run("accepted with its details", func(t *testing.T) {
+		out := verify(t, "/api/v1/user", pinned, claims("pathops-tenant-control-plane", pathopsDetails()))
+		res := requireOutput[*auth.AuthenticationSuccess](t, out).Result
+		d := res.(interface {
+			PathOpsDelegation() *pathops.Delegation
+		}).PathOpsDelegation()
+		require.NotNil(t, d)
+		assert.Equal(t, "app-a", d.Details[0].Repository)
+	})
+	for name, tc := range map[string]struct {
+		path   string
+		tweaks []tweak
+		want   string
+	}{
+		// The integration's rules let it through; the configured party does not.
+		"other authorized party": {"/api/v1/user", []tweak{pinTo("someone-else"), claims("someone-else", pathopsDetails())}, "azp is not the authorized party"},
+		// The integration's own rule already refuses a token of another party.
+		"rule refuses party":     {"/api/v1/user", []tweak{pinned, claims("someone-else", pathopsDetails())}, `claim "azp" must be`},
+		"no details":             {"/api/v1/user", []tweak{pinned, claims("pathops-tenant-control-plane", nil)}, "authorization_details missing"},
+		"not the API":            {"/user2/app-a.git/info/refs", []tweak{pinned, claims("pathops-tenant-control-plane", pathopsDetails())}, "accepted only by the API"},
+		"integration not pinned": {"/api/v1/user", []tweak{claims("pathops-tenant-control-plane", pathopsDetails())}, "must pin sub and azp"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			out := verify(t, tc.path, tc.tweaks...)
+			err := requireOutput[*auth.AuthenticationAttemptedIncorrectCredential](t, out).Error
+			require.ErrorContains(t, err, tc.want)
+		})
+	}
+}
diff --git a/services/auth/pathops/pathops.go b/services/auth/pathops/pathops.go
new file mode 100644
index 0000000..178b9c1
--- /dev/null
+++ b/services/auth/pathops/pathops.go
@@ -0,0 +1,309 @@
+// Copyright 2026 The PathOps Authors. All rights reserved.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Package pathops enforces PathOps delegated authorization (PathOps Decision
+// 0050) on Forgejo's API.
+//
+// The PathOps Tenant Control Plane acts in a user's account with short-lived
+// JWTs minted by the Cell's Dex for one approved operation. Such a token
+// reaches Forgejo through the user's Authorized Integration (issuer, audience
+// and the claim rules pin it to the user and to the Tenant CP), whose scope
+// is broad because Forgejo's API needs it (creating a personal repository
+// requires write:user and write:repository). The token's
+// authorization_details (RFC 9396) are the real boundary: a request is
+// allowed only when one of them authorizes exactly its action on its
+// resource. Everything else is refused before any handler runs.
+//
+// Detail vocabulary v1 (tool "forgejo"):
+//
+//	pathops_repository  owner, repository, actions create|seed
+//	pathops_webhook     owner, repository, url, events, actions configure
+//
+// API calls allowed (owner must be the token's user):
+//
+//	GET  /user                                  any token
+//	POST /user/repos {name}                     repository create of name
+//	GET  /repos/{o}/{r}, .../branches/{b},      repository create or seed of r
+//	     .../git/trees/{sha}
+//	POST /repos/{o}/{r}/contents                repository seed of r
+//	GET  /repos/{o}/{r}/hooks                   webhook configure of r
+//	POST /repos/{o}/{r}/hooks {config.url,      webhook configure of r: the url,
+//	     events}                                and events among the detail's
+//	PATCH /repos/{o}/{r}/hooks/{id} {same}      same
+package pathops
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"regexp"
+	"slices"
+	"strings"
+)
+
+// Detail types and actions of vocabulary v1.
+const (
+	TypeRepository = "pathops_repository"
+	TypeWebhook    = "pathops_webhook"
+	Tool           = "forgejo"
+)
+
+// Detail is one forgejo authorization detail.
+type Detail struct {
+	Type       string   `json:"type"`
+	Version    int      `json:"version"`
+	Tool       string   `json:"tool"`
+	Owner      string   `json:"owner"`
+	Repository string   `json:"repository"`
+	URL        string   `json:"url,omitempty"`
+	Events     []string `json:"events,omitempty"`
+	Actions    []string `json:"actions"`
+}
+
+// Delegation is the PathOps authority of one token.
+type Delegation struct {
+	AuthorizedParty string
+	Grant           string
+	Details         []Detail
+}
+
+// ErrDenied: the token's authorization_details do not authorize the request.
+var ErrDenied = errors.New("pathops delegation: not authorized by the token's authorization_details")
+
+var name = regexp.MustCompile(`^[A-Za-z0-9._-]{1,100}$`)
+
+var allowed = map[string][]string{
+	TypeRepository: {"create", "seed"},
+	TypeWebhook:    {"configure"},
+}
+
+// Parse reads and validates the PathOps claims of a token: azp and a
+// non-empty authorization_details array whose forgejo details are well
+// formed (details of other tools are not authority here and are ignored; a
+// token needs at least one forgejo detail).
+func Parse(claims map[string]any) (*Delegation, error) {
+	azp, _ := claims["azp"].(string)
+	grant, _ := claims["pathops_grant"].(string)
+	raw, err := json.Marshal(claims["authorization_details"])
+	if err != nil || claims["authorization_details"] == nil {
+		return nil, errors.New("pathops delegation: authorization_details missing")
+	}
+	var all []json.RawMessage
+	if err := json.Unmarshal(raw, &all); err != nil {
+		return nil, errors.New("pathops delegation: authorization_details is not an array")
+	}
+	d := &Delegation{AuthorizedParty: azp, Grant: grant}
+	for _, el := range all {
+		var head struct {
+			Tool string `json:"tool"`
+		}
+		if json.Unmarshal(el, &head) != nil || head.Tool != Tool {
+			continue
+		}
+		var dt Detail
+		dec := json.NewDecoder(bytes.NewReader(el))
+		dec.DisallowUnknownFields()
+		if err := dec.Decode(&dt); err != nil {
+			return nil, fmt.Errorf("pathops delegation: malformed forgejo detail: %w", err)
+		}
+		if err := dt.validate(); err != nil {
+			return nil, err
+		}
+		d.Details = append(d.Details, dt)
+	}
+	if len(d.Details) == 0 {
+		return nil, errors.New("pathops delegation: no forgejo authorization_details")
+	}
+	return d, nil
+}
+
+func (dt Detail) validate() error {
+	acts, ok := allowed[dt.Type]
+	switch {
+	case !ok || dt.Version != 1:
+		return fmt.Errorf("pathops delegation: unknown detail type %q version %d", dt.Type, dt.Version)
+	case !name.MatchString(dt.Owner) || !name.MatchString(dt.Repository):
+		return errors.New("pathops delegation: detail owner/repository invalid")
+	case len(dt.Actions) == 0:
+		return errors.New("pathops delegation: detail without actions")
+	case dt.Type == TypeWebhook && (dt.URL == "" || len(dt.Events) == 0):
+		return errors.New("pathops delegation: webhook detail without url or events")
+	case dt.Type == TypeRepository && (dt.URL != "" || len(dt.Events) != 0):
+		return errors.New("pathops delegation: repository detail with webhook fields")
+	}
+	for _, a := range dt.Actions {
+		if !slices.Contains(acts, a) {
+			return fmt.Errorf("pathops delegation: action %q is not a %s action", a, dt.Type)
+		}
+	}
+	return nil
+}
+
+func (d *Delegation) find(typ, owner, repo, action string) *Detail {
+	for i, dt := range d.Details {
+		if dt.Type == typ && strings.EqualFold(dt.Owner, owner) && strings.EqualFold(dt.Repository, repo) &&
+			slices.Contains(dt.Actions, action) {
+			return &d.Details[i]
+		}
+	}
+	return nil
+}
+
+// maxBody bounds the request bodies read for a decision (repository and
+// webhook creation are small).
+const maxBody = 64 << 10
+
+// Authorize decides r for the token's user login (its lower-case name). The
+// body of a request it reads is restored for the handler. apiPrefix is the
+// API v1 path prefix (AppSubURL + "/api/v1").
+func (d *Delegation) Authorize(r *http.Request, login, apiPrefix string) error {
+	// Decide on the escaped path, segment by segment, as the router matches
+	// it: a segment that decodes to a slash, nothing, "." or ".." is refused.
+	rest, ok := strings.CutPrefix(r.URL.EscapedPath(), apiPrefix+"/")
+	if !ok {
+		return fmt.Errorf("%w: only the API v1 accepts delegated tokens", ErrDenied)
+	}
+	seg := strings.Split(rest, "/")
+	for i, s := range seg {
+		d, err := url.PathUnescape(s)
+		if err != nil || d == "" || d == "." || d == ".." || strings.Contains(d, "/") {
+			return fmt.Errorf("%w: malformed path", ErrDenied)
+		}
+		seg[i] = d
+	}
+	m := r.Method
+	switch {
+	case m == http.MethodGet && len(seg) == 1 && seg[0] == "user":
+		return nil
+	case m == http.MethodPost && len(seg) == 2 && seg[0] == "user" && seg[1] == "repos":
+		var body struct {
+			Name string `json:"name"`
+		}
+		if err := readJSON(r, &body); err != nil {
+			return err
+		}
+		if d.find(TypeRepository, login, body.Name, "create") == nil {
+			return fmt.Errorf("%w: create repository %s/%s", ErrDenied, login, body.Name)
+		}
+		return nil
+	case len(seg) >= 3 && seg[0] == "repos":
+		owner, repo, sub := seg[1], seg[2], seg[3:]
+		if !strings.EqualFold(owner, login) {
+			return fmt.Errorf("%w: %s/%s is not the token user's", ErrDenied, owner, repo)
+		}
+		return d.repository(r, owner, repo, sub)
+	}
+	return fmt.Errorf("%w: %s %s", ErrDenied, m, r.URL.Path)
+}
+
+func (d *Delegation) repository(r *http.Request, owner, repo string, sub []string) error {
+	m := r.Method
+	readable := d.find(TypeRepository, owner, repo, "create") != nil || d.find(TypeRepository, owner, repo, "seed") != nil
+	switch {
+	case m == http.MethodGet && len(sub) == 0, // the repository
+		m == http.MethodGet && len(sub) == 2 && sub[0] == "branches",
+		m == http.MethodGet && len(sub) == 3 && sub[0] == "git" && sub[1] == "trees":
+		if readable {
+			return nil
+		}
+	case m == http.MethodPost && len(sub) == 1 && sub[0] == "contents":
+		if d.find(TypeRepository, owner, repo, "seed") != nil {
+			return nil
+		}
+	case m == http.MethodGet && len(sub) == 1 && sub[0] == "hooks":
+		if d.find(TypeWebhook, owner, repo, "configure") != nil {
+			return nil
+		}
+	case (m == http.MethodPost && len(sub) == 1 && sub[0] == "hooks") ||
+		(m == http.MethodPatch && len(sub) == 2 && sub[0] == "hooks"):
+		dt := d.find(TypeWebhook, owner, repo, "configure")
+		if dt == nil {
+			break
+		}
+		var body struct {
+			Config struct {
+				URL string `json:"url"`
+			} `json:"config"`
+			Events []string `json:"events"`
+		}
+		if err := readJSON(r, &body); err != nil {
+			return err
+		}
+		if body.Config.URL != dt.URL {
+			return fmt.Errorf("%w: webhook url of %s/%s", ErrDenied, owner, repo)
+		}
+		for _, e := range body.Events {
+			if !slices.Contains(dt.Events, e) {
+				return fmt.Errorf("%w: webhook event %q of %s/%s", ErrDenied, e, owner, repo)
+			}
+		}
+		return nil
+	}
+	return fmt.Errorf("%w: %s %s", ErrDenied, m, r.URL.Path)
+}
+
+// readJSON decodes r's body into v and puts the body back for the handler.
+func readJSON(r *http.Request, v any) error {
+	if r.Body == nil {
+		return fmt.Errorf("%w: empty body", ErrDenied)
+	}
+	raw, err := io.ReadAll(io.LimitReader(r.Body, maxBody+1))
+	_ = r.Body.Close()
+	r.Body = io.NopCloser(bytes.NewReader(raw))
+	if err != nil || len(raw) > maxBody {
+		return fmt.Errorf("%w: unreadable body", ErrDenied)
+	}
+	if err := distinctKeys(json.NewDecoder(bytes.NewReader(raw))); err != nil {
+		return fmt.Errorf("%w: %v", ErrDenied, err)
+	}
+	if err := json.Unmarshal(raw, v); err != nil {
+		return fmt.Errorf("%w: body is not JSON", ErrDenied)
+	}
+	return nil
+}
+
+// distinctKeys rejects a JSON value with two keys of one object that are
+// equal ignoring case: decoders disagree on which one wins, so the value
+// checked here could differ from the value the handler uses.
+func distinctKeys(dec *json.Decoder) error {
+	tok, err := dec.Token()
+	if err != nil {
+		return errors.New("body is not JSON")
+	}
+	delim, ok := tok.(json.Delim)
+	if !ok {
+		return nil
+	}
+	switch delim {
+	case '{':
+		seen := map[string]bool{}
+		for dec.More() {
+			key, err := dec.Token()
+			if err != nil {
+				return errors.New("body is not JSON")
+			}
+			k := strings.ToLower(fmt.Sprint(key))
+			if seen[k] {
+				return fmt.Errorf("repeated key %q", key)
+			}
+			seen[k] = true
+			if err := distinctKeys(dec); err != nil {
+				return err
+			}
+		}
+	case '[':
+		for dec.More() {
+			if err := distinctKeys(dec); err != nil {
+				return err
+			}
+		}
+	}
+	if _, err := dec.Token(); err != nil {
+		return errors.New("body is not JSON")
+	}
+	return nil
+}
