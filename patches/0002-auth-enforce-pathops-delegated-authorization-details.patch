+// pathopsDelegation checks a token of the PathOps delegation issuer: its
+// integration pins sub and azp (equality rules, so it binds one user and the
+// Tenant CP), azp is the configured authorized party, the request is an API
+// v1 request (not web, git or packages), and its authorization_details parse.
+// Each API request is then authorized against the details
+// (routers/api/shared).
+func (a *AuthorizedIntegration) pathopsDelegation(req *http.Request, claims *flexibleClaims,
+	ai *auth_model.AuthorizedIntegration,
+) (*pathops.Delegation, error) {
+	pinned := map[string]bool{}
+	if ai.ClaimRules != nil {
+		for _, r := range ai.ClaimRules.Rules {
+			if r.Comparison == auth_model.ClaimEqual {
+				pinned[r.Claim] = true
+			}
+		}
+	}
+	if !pinned["sub"] || !pinned["azp"] {
+		return nil, errors.New("pathops delegation: the integration must pin sub and azp")
+	}
+	party := setting.AuthorizedIntegration.PathOpsDelegationAuthorizedParty
+	if azp, _ := claims.other["azp"].(string); party == "" || azp != party {
+		return nil, errors.New("pathops delegation: azp is not the authorized party")
+	}
+	if !strings.HasPrefix(req.URL.Path, setting.AppSubURL+"/api/v1/") {
+		return nil, errors.New("pathops delegation: delegated tokens are accepted only by the API")
+	}
+	return pathops.Parse(claims.other)
+}
